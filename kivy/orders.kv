<OrdersScreen>:
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: "Shopkeeper Orders"
            font_size: 24
        ScrollView:
            GridLayout:
                id: orders_grid
                cols: 1
                size_hint_y: None
                height: self.minimum_height
        Button:
            text: "Refresh"
            on_release: root.on_pre_enter()
        Button:
            text: "Back to Login"
            on_release: app.root.current = "login"
